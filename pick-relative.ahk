#Requires AutoHotkey v2.0
#SingleInstance Force

; ══════════════════════════════════════════════════════════════
;  相对坐标标定工具  pick-relative.ahk
;
;  用途：在小程序窗口上标记「监视点 / 点击点 / 目标颜色」，
;        记录的是【窗口客户区百分比坐标 + 颜色】，直接写回
;        color-click.ini，供 color-click.ahk 使用。
;        窗口怎么缩放、拖动、换机器，标一次就够。
;        规则条数不限，想加多少加多少。
; ──────────────────────────────────────────────────────────────
;  用法
;    1. 打开小程序窗口（不需要在前台，只要可见）
;    2. 运行本脚本，会出现左上角提示
;    3. 把鼠标悬停到想标记的像素上，按热键：
;         Ctrl+Alt+S   一键三点合一：监视点 = 点击点 = 鼠标位置，并取色
;                      （最常用：盯这里、变色就点这里）
;         Ctrl+Alt+1   只标「监视点」+ 自动取该点颜色
;         Ctrl+Alt+2   只标「点击点」
;         Ctrl+Alt+3   只用鼠标处的颜色作为「目标颜色」
;         Ctrl+Alt+N   新增一条规则，并自动切过去（想标几条按几次）
;         Ctrl+Alt+D   删除当前规则
;         Ctrl+Alt+R   切换到下一条         Ctrl+Alt+Shift+R  上一条
;         Ctrl+Alt+Shift+1~9   直接跳到第 N 条
;         Ctrl+Alt+0   重新载入配置
;         F2           退出
;    4. 标记会立刻保存到 color-click.ini
;
;  说明：鼠标必须悬停在目标窗口上才会记录，否则只提示不写入。
;        本脚本只改动「规则*」和「规则数」，通用参数原样保留。
; ══════════════════════════════════════════════════════════════

CoordMode "Mouse",   "Screen"
CoordMode "Pixel",   "Screen"
CoordMode "ToolTip", "Screen"

配置文件   := A_ScriptDir "\color-click.ini"
最大规则数 := 30

; 通用参数：加载时读进来，保存时原样写回去
; （原来这几个是写死的常量，会把你在 ini 里调过的值覆盖掉 —— 已修）
通用 := {
    检查间隔: 1000,
    点击后等待: 800,
    最大点击数: 0,
    颜色容差: 12,
    触发模式: "edge",
    要求窗口激活: true,
    目标窗口: "ahk_exe douyin.exe"
}

规则集   := []
当前规则 := 1

; ══════════════════════════════════════════════════════════════
;  工具函数（与 color-click.ahk 保持一致）
; ══════════════════════════════════════════════════════════════
颜色文本(c) {
    return (c < 0) ? "——" : Format("0x{:06X}", c & 0xFFFFFF)
}

取客户区(hwnd, &cx, &cy, &cw, &ch) {
    pt := Buffer(8)
    NumPut("Int", 0, "Int", 0, pt)
    DllCall("ClientToScreen", "Ptr", hwnd, "Ptr", pt)
    cx := NumGet(pt, 0, "Int")
    cy := NumGet(pt, 4, "Int")
    rect := Buffer(16)
    DllCall("GetClientRect", "Ptr", hwnd, "Ptr", rect)
    cw := NumGet(rect, 8, "Int")
    ch := NumGet(rect, 12, "Int")
}

读配置() {
    global 配置文件
    m := Map()
    if !FileExist(配置文件)
        return m
    try {
        txt := FileRead(配置文件, "UTF-8")
    } catch {
        return m
    }
    for line in StrSplit(txt, "`n", "`r") {
        line := Trim(line)
        if (line = "")
            continue
        head := SubStr(line, 1, 1)
        if (head = ";" || head = "#")
            continue
        p := InStr(line, "=")
        if !p
            continue
        m[Trim(SubStr(line, 1, p - 1))] := Trim(SubStr(line, p + 1))
    }
    return m
}

取整(m, k, d) {
    return m.Has(k) ? Integer(m[k]) : d
}

取浮(m, k, d) {
    return m.Has(k) ? Round(Number(m[k]), 2) : d
}

取串(m, k, d) {
    return m.Has(k) ? m[k] : d
}

; 一条空规则：-1 表示尚未标定
新规则对象() {
    return {
        监视点RX: -1, 监视点RY: -1, 目标颜色: -1,
        点击点RX: -1, 点击点RY: -1,
        启用: true
    }
}

加载配置(静默 := false) {
    global 通用, 规则集, 配置文件, 当前规则

    m := 读配置()
    if (m.Count = 0) {
        if !静默
            MsgBox("配置文件不存在或为空：`n" . 配置文件, "缺少配置", "Icon!")
        return false
    }

    通用.检查间隔     := 取整(m, "检查间隔",   1000)
    通用.点击后等待   := 取整(m, "点击后等待", 800)
    通用.最大点击数   := 取整(m, "最大点击数", 0)
    通用.颜色容差     := 取整(m, "颜色容差",   12)
    通用.触发模式     := 取串(m, "触发模式",   "edge")
    通用.要求窗口激活 := (取整(m, "要求窗口激活", 1) = 1)
    通用.目标窗口     := 取串(m, "目标窗口",   "ahk_exe douyin.exe")

    规则集 := []
    loop 取整(m, "规则数", 0) {
        i := A_Index
        规则集.Push({
            监视点RX: 取浮(m, "规则" . i . "监视点RX", -1),
            监视点RY: 取浮(m, "规则" . i . "监视点RY", -1),
            目标颜色: 取整(m, "规则" . i . "目标颜色", -1),
            点击点RX: 取浮(m, "规则" . i . "点击点RX", -1),
            点击点RY: 取浮(m, "规则" . i . "点击点RY", -1),
            启用: (取整(m, "规则" . i . "启用", 1) = 1)
        })
    }
    if (当前规则 > 规则集.Length)
        当前规则 := 规则集.Length > 0 ? 规则集.Length : 1
    return 规则集.Length > 0
}

保存配置() {
    global 通用, 规则集, 配置文件

    ; 只重写「规则N…」这一段，其余内容（通用参数、注释、以及以后新增
    ; 的开关）全部原样保留 —— 免得标一次点就把别的设置弄丢
    L := []
    if FileExist(配置文件) {
        try {
            for line in StrSplit(FileRead(配置文件, "UTF-8"), "`n", "`r") {
                t := RTrim(line)
                s := Trim(t)
                if (s != "" && (RegExMatch(s, "^;+.*规则 *[0-9]")
                             || RegExMatch(s, "^规则数 *=")
                             || RegExMatch(s, "^规则[0-9]+[^=]*=")))
                    continue
                if (s = "" && (L.Length = 0 || L[L.Length] = ""))
                    continue
                L.Push(t)
            }
        }
    }

    if (L.Length = 0) {
        ; 全新文件：写一份带头部说明和默认参数的骨架
        L.Push("; color-click.ahk 配置文件")
        L.Push("; 颜色写 0xRRGGBB（和脚本取到的颜色一致），-1 = 未标定")
        L.Push("; 坐标写「窗口客户区百分比」数值（0-100）")
        L.Push("; 用 pick-relative.ahk 标定，脚本运行时按当前窗口大小实时换算")
        L.Push("")
        L.Push("; ─── 运行方式 ───")
        L.Push("取色方式=后台")
        L.Push("点击方式=消息")
        L.Push("点击后还原=1")
        L.Push("最小化自动还原=1")
        L.Push("挂边宽度=6")
        L.Push("")
        L.Push("; ─── 通用 ───")
        L.Push("检查间隔=1000")
        L.Push("点击后等待=800")
        L.Push("最大点击数=0")
        L.Push("颜色容差=12")
        L.Push("触发模式=edge")
        L.Push("要求窗口激活=0")
        L.Push("目标窗口=" . 通用.目标窗口)
    }

    while (L.Length > 0 && L[L.Length] = "")
        L.Pop()

    L.Push("")
    L.Push("规则数=" . 规则集.Length)
    for i, r in 规则集 {
        L.Push("")
        L.Push("; ─── 规则 " . i . " ───")
        L.Push("规则" . i . "监视点RX=" . Format("{:.2f}", r.监视点RX))
        L.Push("规则" . i . "监视点RY=" . Format("{:.2f}", r.监视点RY))
        L.Push("规则" . i . "目标颜色=" . ((r.目标颜色 < 0) ? "-1" : Format("0x{:06X}", r.目标颜色)))
        L.Push("规则" . i . "点击点RX=" . Format("{:.2f}", r.点击点RX))
        L.Push("规则" . i . "点击点RY=" . Format("{:.2f}", r.点击点RY))
        L.Push("规则" . i . "启用=" . (r.启用 ? 1 : 0))
    }
    txt := ""
    for l in L
        txt .= l . "`r`n"
    try {
        f := FileOpen(配置文件, "w", "UTF-8")
        f.Write(txt)
        f.Close()
    }
}

; ══════════════════════════════════════════════════════════════
;  标定核心：鼠标位置 -> 百分比坐标（相对目标窗口客户区）
;  类型："监视" / "点击" / "颜色" / "合一"
; ══════════════════════════════════════════════════════════════
标记(类型) {
    global 通用, 规则集, 当前规则

    if (规则集.Length = 0) {
        刷新提示("（没有规则，先按 Ctrl+Alt+N 新增一条）")
        return
    }

    hwnd := WinExist(通用.目标窗口)
    if !hwnd {
        刷新提示("（未找到目标窗口，打不开抖音小游戏吧）")
        return
    }

    MouseGetPos(&mx, &my, &mwin)
    ; 鼠标下面的窗口可能是子控件，取顶层窗口再比对
    root := (mwin) ? DllCall("GetAncestor", "Ptr", mwin, "UInt", 2, "Ptr") : 0
    if (root != hwnd) {
        刷新提示("（鼠标不在目标窗口上，本次未记录）")
        return
    }

    取客户区(hwnd, &cx, &cy, &cw, &ch)
    if (cw < 10 || ch < 10) {
        刷新提示("（窗口客户区异常）")
        return
    }

    rx := (mx - cx) / cw * 100
    ry := (my - cy) / ch * 100
    if (rx < 0 || rx > 100 || ry < 0 || ry > 100) {
        刷新提示("（鼠标在客户区外，本次未记录）")
        return
    }
    rx := Round(rx, 2)
    ry := Round(ry, 2)

    r := 规则集[当前规则]
    if (类型 = "监视" || 类型 = "合一") {
        r.监视点RX := rx
        r.监视点RY := ry
        r.目标颜色 := PixelGetColor(mx, my, "RGB")
        r.启用     := true
    }
    if (类型 = "点击" || 类型 = "合一") {
        r.点击点RX := rx
        r.点击点RY := ry
    }
    if (类型 = "颜色") {
        r.目标颜色 := PixelGetColor(mx, my, "RGB")
    }

    保存配置()
    刷新提示("已写入规则 " . 当前规则 . "【" . 类型 . "】  (" .
        Format("{:.1f}", rx) . "%, " . Format("{:.1f}", ry) . "%)" .
        ((类型 = "监视" || 类型 = "合一" || 类型 = "颜色")
            ? "  色=" . 颜色文本(r.目标颜色) : ""))
}

; ── 新增一条规则并切过去 ─────────────────────────────────────
新增规则() {
    global 规则集, 当前规则, 最大规则数

    if (规则集.Length >= 最大规则数) {
        刷新提示("（已经 " . 最大规则数 . " 条了，不再新增）")
        return
    }

    ; 最后一条还是完全空白的话，就别再堆一条空的，直接用它
    末 := (规则集.Length > 0) ? 规则集[规则集.Length] : 0
    if (末 && 末.监视点RX < 0 && 末.点击点RX < 0 && 末.目标颜色 < 0) {
        当前规则 := 规则集.Length
        刷新提示("（最后一条还是空的，直接用它标）")
        return
    }

    规则集.Push(新规则对象())
    当前规则 := 规则集.Length
    保存配置()
    刷新提示("已新增规则 " . 当前规则 . "，现在共 " . 规则集.Length . " 条 —— 接着标就行")
}

; ── 删除当前规则 ─────────────────────────────────────────────
删除规则() {
    global 规则集, 当前规则

    if (规则集.Length = 0)
        return

    if (规则集.Length = 1) {
        规则集[1] := 新规则对象()
        当前规则 := 1
        保存配置()
        刷新提示("（只剩一条，已把它的标定清空）")
        return
    }

    删 := 当前规则
    规则集.RemoveAt(删)
    if (当前规则 > 规则集.Length)
        当前规则 := 规则集.Length
    保存配置()
    刷新提示("已删除原规则 " . 删 . "，现在共 " . 规则集.Length . " 条")
}

; ── 跳到第 n 条 ──────────────────────────────────────────────
跳到(n) {
    global 规则集, 当前规则

    if (规则集.Length = 0)
        return
    if (n > 规则集.Length) {
        刷新提示("（现在只有 " . 规则集.Length . " 条，没有第 " . n . " 条）`n（要加规则按 Ctrl+Alt+N）")
        return
    }
    当前规则 := n
    刷新提示()
}

; ══════════════════════════════════════════════════════════════
;  提示
; ══════════════════════════════════════════════════════════════
刷新提示(备注 := "") {
    global 通用, 规则集, 当前规则, 配置文件

    hwnd := WinExist(通用.目标窗口)
    窗口信息 := "目标窗口未找到"
    if hwnd {
        取客户区(hwnd, &cx, &cy, &cw, &ch)
        窗口信息 := "客户区 " . cw . "x" . ch
    }

    n := 规则集.Length
    t := (备注 = "" ? "" : ">> " . 备注 . "`n")
    t .= "标定工具   当前第 " . 当前规则 . " 条 / 共 " . n . " 条      " . 窗口信息 . "`n"
    t .= "──────────────────────────────`n"

    显示上限 := 16
    for i, r in 规则集 {
        if (i > 显示上限) {
            t .= "…… 还有 " . (n - 显示上限) . " 条（用 Ctrl+Alt+Shift+数字 直接跳）`n"
            break
        }
        指针 := (i = 当前规则) ? " ▶" : "  "
        if (r.监视点RX < 0) {
            t .= Format("{:>2}", i) . 指针 . "  待标定`n"
            continue
        }
        点文本 := (r.点击点RX < 0)
            ? "点 未标"
            : "点 " . Format("{:>5.1f},{:>5.1f}", r.点击点RX, r.点击点RY) . "%"
        t .= Format("{:>2}", i) . 指针 . "  盯 " .
            Format("{:>5.1f},{:>5.1f}", r.监视点RX, r.监视点RY) . "%  " . 颜色文本(r.目标颜色) .
            "   " . 点文本 . (r.启用 ? "" : "  (已停用)") . "`n"
    }

    t .= "──────────────────────────────`n"
    t .= "Ctrl+Alt+S 三点合一   1 监视点取色   2 点击点   3 只取色`n"
    t .= "Ctrl+Alt+N 新增一条   D 删除本条   R 下一条   Shift+R 上一条`n"
    t .= "Ctrl+Alt+Shift+1~9 跳到第 N 条      Ctrl+Alt+0 重载      F2 退出"
    ToolTip(t, 20, 20)
    SetTimer(隐藏提示, -15000)
}

隐藏提示() {
    ToolTip()
}

; ══════════════════════════════════════════════════════════════
;  热键（必须写在顶层，不能放进函数里）
; ══════════════════════════════════════════════════════════════
^!s:: 标记("合一")
^!1:: 标记("监视")
^!2:: 标记("点击")
^!3:: 标记("颜色")

^!n:: 新增规则()
^!d:: 删除规则()

^!r:: {
    global 当前规则, 规则集
    if (规则集.Length = 0)
        return
    当前规则 := Mod(当前规则, 规则集.Length) + 1
    刷新提示()
}

^!+r:: {
    global 当前规则, 规则集
    if (规则集.Length = 0)
        return
    当前规则 := (当前规则 <= 1) ? 规则集.Length : 当前规则 - 1
    刷新提示()
}

^!+1:: 跳到(1)
^!+2:: 跳到(2)
^!+3:: 跳到(3)
^!+4:: 跳到(4)
^!+5:: 跳到(5)
^!+6:: 跳到(6)
^!+7:: 跳到(7)
^!+8:: 跳到(8)
^!+9:: 跳到(9)

^!0:: {
    加载配置()
    刷新提示("已重新载入配置")
}

F2:: {
    ToolTip()
    ExitApp()
}

; ══════════════════════════════════════════════════════════════
;  启动
; ══════════════════════════════════════════════════════════════
if (A_Args.Length > 0 && A_Args[1] = "/dump") {
    s := ""
    if 加载配置(true) {
        hwnd := WinExist(通用.目标窗口)
        if hwnd {
            取客户区(hwnd, &cx, &cy, &cw, &ch)
            s .= "目标窗口客户区: " . cw . " x " . ch . "  屏幕原点(" . cx . "," . cy . ")`r`n"
        } else {
            s .= "目标窗口未找到`r`n"
        }
        s .= "通用: 间隔=" . 通用.检查间隔 . "ms  冷却=" . 通用.点击后等待 .
              "ms  最大点击=" . 通用.最大点击数 . "  容差=" . 通用.颜色容差 .
              "  触发=" . 通用.触发模式 . "  需激活=" . 通用.要求窗口激活 . "`r`n"
        s .= "规则数=" . 规则集.Length . "`r`n"
        for i, r in 规则集 {
            s .= "规则" . i . ": 盯(" . Format("{:.2f}", r.监视点RX) . "," . Format("{:.2f}", r.监视点RY) . "%)" .
                 "  色=" . 颜色文本(r.目标颜色) .
                 "  点(" . Format("{:.2f}", r.点击点RX) . "," . Format("{:.2f}", r.点击点RY) . "%)" .
                 "  启用=" . r.启用 . "`r`n"
        }
    } else {
        s := "配置加载失败`r`n"
    }
    FileAppend s, "*"
    ExitApp()
}

if !加载配置() {
    ; 配置为空时给一个最小骨架，让用户能直接开始标
    规则集 := [新规则对象()]
    当前规则 := 1
    保存配置()
    MsgBox("配置文件不存在，已生成初始配置。`n`n请在抖音小游戏窗口上用热键标记点位。", "初始化", "64")
}
刷新提示()
